{
  "name": "endpoint-kit",
  "version": "0.2.0",
  "description": "Declare backend endpoints once with Zod (or any Standard Schema) and get a fully typed API client for fetch, axios or ofetch",
  "keywords": [
    "typescript",
    "api",
    "client",
    "repository",
    "zod",
    "standard-schema",
    "fetch",
    "axios",
    "ofetch",
    "type-safe",
    "openapi",
    "codegen",
    "pagination",
    "sse"
  ],
  "homepage": "https://github.com/sonicname/endpoint-kit#readme",
  "bugs": {
    "url": "https://github.com/sonicname/endpoint-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonicname/endpoint-kit.git"
  },
  "license": "MIT",
  "author": "Phạm Anh Đức <phamanhduc2k2@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./openapi": {
      "import": {
        "types": "./dist/openapi/index.d.ts",
        "default": "./dist/openapi/index.js"
      },
      "require": {
        "types": "./dist/openapi/index.d.cts",
        "default": "./dist/openapi/index.cjs"
      }
    },
    "./axios": {
      "import": {
        "types": "./dist/axios/index.d.ts",
        "default": "./dist/axios/index.js"
      },
      "require": {
        "types": "./dist/axios/index.d.cts",
        "default": "./dist/axios/index.cjs"
      }
    },
    "./ofetch": {
      "import": {
        "types": "./dist/ofetch/index.d.ts",
        "default": "./dist/ofetch/index.js"
      },
      "require": {
        "types": "./dist/ofetch/index.d.cts",
        "default": "./dist/ofetch/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./tanstack-query": {
      "import": {
        "types": "./dist/tanstack-query/index.d.ts",
        "default": "./dist/tanstack-query/index.js"
      },
      "require": {
        "types": "./dist/tanstack-query/index.d.cts",
        "default": "./dist/tanstack-query/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./server/node": {
      "import": {
        "types": "./dist/server/node/index.d.ts",
        "default": "./dist/server/node/index.js"
      },
      "require": {
        "types": "./dist/server/node/index.d.cts",
        "default": "./dist/server/node/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.9.1",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist coverage docs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:api": "typedoc",
    "size": "size-limit",
    "check:exports": "attw --pack . && publint",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm check:exports",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.3.0",
    "hono": "^4.13.13",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "rimraf": "^6.1.3",
    "size-limit": "^14.1.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "bin": {
    "endpoint-kit": "./dist/cli.js"
  },
  "typesVersions": {
    "*": {
      "openapi": [
        "./dist/openapi/index.d.ts"
      ],
      "axios": [
        "./dist/axios/index.d.ts"
      ],
      "ofetch": [
        "./dist/ofetch/index.d.ts"
      ],
      "testing": [
        "./dist/testing/index.d.ts"
      ],
      "tanstack-query": [
        "./dist/tanstack-query/index.d.ts"
      ],
      "server": [
        "./dist/server/index.d.ts"
      ],
      "server/node": [
        "./dist/server/node/index.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  }
}
